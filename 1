<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Christmas Countdown</title>
<style>
  :root {
    --navy: #1e3254; --navy-deep: #121f36; --tan: #a88650;
    --gold: #c9a366; --cream: #f5eee0; --flap: #16253f; --flap-lo: #101b30;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 100%; height: 100%; overflow: hidden; cursor: none; background: var(--navy-deep); }
  body { background: radial-gradient(ellipse at 50% 40%, #2a4470 0%, var(--navy) 55%, var(--navy-deep) 100%); }
  #snow { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; }

  #stage { position: absolute; left: 50%; top: 50%; width: 1920px; height: 1080px;
    transform-origin: 0 0; z-index: 2; color: var(--cream); font-family: Georgia, 'Times New Roman', serif; }

  /* fairy lights */
  #wire { position: absolute; top: 0; left: 0; width: 1920px; height: 90px; }
  .bulb { position: absolute; width: 22px; height: 32px; border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%;
    animation: twinkle 2.4s ease-in-out infinite; }
  .bulb::before { content: ""; position: absolute; left: 6px; top: -9px; width: 10px; height: 10px; background: #0b1424; border-radius: 2px; }
  @keyframes twinkle { 0%,100% { opacity: 1; filter: brightness(1.15); } 50% { opacity: .45; filter: brightness(.7); } }

  h1 { position: absolute; top: 125px; width: 100%; text-align: center; font-weight: 400; font-style: italic;
    font-size: 92px; letter-spacing: 2px; color: var(--gold); text-shadow: 0 4px 24px rgba(0,0,0,.5); }
  
  #row { position: absolute; top: 290px; left: 0; width: 100%; display: flex; justify-content: center; gap: 64px; }
  .group { display: flex; flex-direction: column; align-items: center; gap: 28px; }
  .digits { display: flex; gap: 12px; }
  .label { font-size: 40px; font-style: italic; color: var(--gold); }

  /* split flap */
  .flap { position: relative; width: 150px; height: 230px; perspective: 700px; font-family: Impact, 'Arial Narrow', 'Helvetica Neue', Arial, sans-serif; }
  .half { position: absolute; left: 0; width: 100%; height: 50%; overflow: hidden; background: var(--flap);
    backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .half span { position: absolute; left: 0; width: 100%; height: 200%; display: flex; align-items: center; justify-content: center;
    font-size: 196px; line-height: 1; color: var(--cream); }
  .top, .ft { top: 0; border-radius: 14px 14px 0 0; border-bottom: 1px solid #000; }
  .bot, .fb { bottom: 0; border-radius: 0 0 14px 14px; background: var(--flap-lo); }
  .top span, .ft span { top: 0; }
  .bot span, .fb span { bottom: 0; }
  .ft { transform-origin: 50% 100%; z-index: 3; display: none; }
  .fb { transform-origin: 50% 0; z-index: 2; display: none; }
  .top::after { content: ""; position: absolute; inset: 0; background: linear-gradient(rgba(255,255,255,.07), transparent); }
  .flap::before, .flap::after { content: ""; position: absolute; top: 50%; width: 10px; height: 22px; margin-top: -11px;
    background: #000; z-index: 5; border-radius: 3px; }
  .flap::before { left: -3px; } .flap::after { right: -3px; }
  .flap.gold .half { background: var(--tan); }
  .flap.gold .bot, .flap.gold .fb { background: #8f6f3f; }
  .flap.gold .half span { color: var(--navy-deep); }

    #logo { position: absolute; bottom: 36px; left: 50%; width: 360px; height: 360px; margin-left: -180px; border-radius: 24px;
    border: 4px solid var(--gold); box-shadow: 0 10px 40px rgba(0,0,0,.5); }
  #msg { display: none; position: absolute; top: 300px; width: 100%; text-align: center; font-size: 150px; font-style: italic;
    color: var(--gold); text-shadow: 0 6px 30px rgba(0,0,0,.6); }
  body.xmas #msg { display: block; } body.xmas #row { display: none; }

  @media (prefers-reduced-motion: reduce) { .bulb { animation: none; } }
</style>
</head>
<body>
<canvas id="snow"></canvas>
<div id="stage">
  <div id="wire"></div>
  <h1 id="title">Countdown to Christmas</h1>
  <div id="msg">Merry Christmas!</div>
  <img id="logo" alt="The Market Tavern" src="data:image/png;base64,">
  <div id="row">
    <div class="group"><div class="digits" id="d"></div><div class="label">days</div></div>
    <div class="group"><div class="digits" id="h"></div><div class="label">hours</div></div>
    <div class="group"><div class="digits" id="m"></div><div class="label">minutes</div></div>
    <div class="group"><div class="digits" id="s"></div><div class="label">seconds</div></div>
  </div>
</div>

<script>
(function () {
  /* ---- scale the 1920x1080 stage to any screen ---- */
  var stage = document.getElementById('stage');
  function fit() {
    var k = Math.min(innerWidth / 1920, innerHeight / 1080);
    stage.style.transform = 'translate(' + (-960 * k) + 'px,' + (-540 * k) + 'px) scale(' + k + ')';
  }
  addEventListener('resize', fit); fit();

  /* ---- fairy lights ---- */
  var wire = document.getElementById('wire'), cols = ['#c9a366', '#f5eee0', '#a88650', '#e3cfa0', '#8fa6cc'];
  var svg = '<svg width="1920" height="90" style="position:absolute;left:0;top:0"><path d="M0 14 Q 96 60 192 14 T 384 14 T 576 14 T 768 14 T 960 14 T 1152 14 T 1344 14 T 1536 14 T 1728 14 T 1920 14" fill="none" stroke="#0b1424" stroke-width="4"/></svg>';
  wire.innerHTML = svg;
  for (var i = 0; i < 20; i++) {
    var b = document.createElement('div'), c = cols[i % cols.length];
    b.className = 'bulb';
    b.style.left = (i * 96 + 74) + 'px';
    b.style.top = (i % 2 ? 22 : 42) + 'px';
    b.style.background = c; b.style.boxShadow = '0 0 26px 6px ' + c;
    b.style.animationDelay = (-(i * 0.37) % 2.4) + 's';
    wire.appendChild(b);
  }

  /* ---- split-flap ---- */
  function Flap(parent, gold) {
    var el = document.createElement('div'); el.className = 'flap' + (gold ? ' gold' : '');
    el.innerHTML = '<div class="half top"><span>0</span></div><div class="half bot"><span>0</span></div>' +
                   '<div class="half ft"><span></span></div><div class="half fb"><span></span></div>';
    parent.appendChild(el);
    var top = el.querySelector('.top span'), bot = el.querySelector('.bot span'),
        ft = el.querySelector('.ft'), fb = el.querySelector('.fb'), cur = '0', busy = false, queued = null;
    this.set = function set(v, instant) {
      if (v === cur) return;
      if (busy) { queued = v; return; }
      var old = cur; cur = v;
      top.textContent = v;
      if (instant || !el.animate) { bot.textContent = v; return; }
      busy = true;
      ft.firstChild.textContent = old; fb.firstChild.textContent = v; bot.textContent = old;
      ft.style.display = fb.style.display = 'block';
      var a = ft.animate([{ transform: 'rotateX(0)' }, { transform: 'rotateX(-90deg)' }], { duration: 260, easing: 'ease-in', fill: 'forwards' });
      var b = fb.animate([{ transform: 'rotateX(90deg)' }, { transform: 'rotateX(0)' }], { duration: 260, delay: 260, easing: 'ease-out', fill: 'both' });
      b.onfinish = function () {
        bot.textContent = v; ft.style.display = fb.style.display = 'none'; a.cancel(); b.cancel(); busy = false;
        if (queued !== null) { var q = queued; queued = null; set(q, true); }
      };
    };
  }
  function Unit(id, n, gold) {
    var p = document.getElementById(id), f = [];
    for (var i = 0; i < n; i++) f.push(new Flap(p, gold));
    this.set = function (num, instant) {
      var s = String(num); while (s.length < n) s = '0' + s;
      for (var i = 0; i < n; i++) f[i].set(s.charAt(i), instant);
    };
  }
  var U = { d: new Unit('d', 3, false), h: new Unit('h', 2, false), m: new Unit('m', 2, false), s: new Unit('s', 2, true) };

  /* ---- countdown (UK time; in December the UK is on GMT = UTC) ---- */
  var first = true;
  function londonParts(d) {
    var p = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', year: 'numeric', month: 'numeric', day: 'numeric' }).formatToParts(d), o = {};
    p.forEach(function (x) { o[x.type] = +x.value; }); return o;
  }
  function tick() {
    var now = new Date(), lp = londonParts(now), isXmas = lp.month === 12 && lp.day === 25;
    document.body.classList.toggle('xmas', isXmas);
    var year = lp.year;
    if (lp.month === 12 && lp.day > 25) year++;
    var diff = isXmas ? 0 : Math.max(0, Date.UTC(year, 11, 25) - now.getTime());
    var t = Math.floor(diff / 1000);
    U.d.set(Math.floor(t / 86400), first); U.h.set(Math.floor(t % 86400 / 3600), first);
    U.m.set(Math.floor(t % 3600 / 60), first); U.s.set(t % 60, first);
    first = false;
  }
  tick(); setInterval(tick, 250);

  /* ---- snow ---- */
  var cv = document.getElementById('snow'), cx = cv.getContext('2d'), flakes = [];
  function size() { cv.width = innerWidth; cv.height = innerHeight; }
  addEventListener('resize', size); size();
  for (var i = 0; i < 140; i++) flakes.push({ x: Math.random(), y: Math.random(), r: 1 + Math.random() * 3.5, v: .4 + Math.random() * 1.1, p: Math.random() * 6.28 });
  var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  function snow() {
    cx.clearRect(0, 0, cv.width, cv.height); cx.fillStyle = 'rgba(255,255,255,.85)';
    flakes.forEach(function (f) {
      if (!still) { f.y += f.v / 700 * (cv.height / 1080 + .3); f.p += .01; f.x += Math.sin(f.p) * .0004; }
      if (f.y > 1.02) { f.y = -.02; f.x = Math.random(); }
      cx.beginPath(); cx.arc(f.x * cv.width, f.y * cv.height, f.r * cv.width / 1920 + .5, 0, 6.28); cx.fill();
    });
    requestAnimationFrame(snow);
  }
  snow();
})();
</script>
</body>
</html>
